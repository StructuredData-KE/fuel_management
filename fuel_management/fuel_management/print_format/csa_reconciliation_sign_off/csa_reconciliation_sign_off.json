{
 "docstatus": 0,
 "doctype": "Print Format",
 "name": "CSA Reconciliation Sign-Off",
 "module": "Fuel Management",
 "doc_type": "Shift Cash Reconciliation",
 "standard": "Yes",
 "custom_format": 1,
 "print_format_builder": 0,
 "align_labels_right": 0,
 "show_section_headings": 0,
 "line_breaks": 0,
 "html": "<div style=\"font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; border: 1px solid #ddd;\">\n    <div style=\"text-align: center; border-bottom: 2px solid #333; padding-bottom: 10px; margin-bottom: 20px;\">\n        <h2>CSA Cash Reconciliation Sign-Off</h2>\n        <h4>Shift: {{ doc.shift }}</h4>\n    </div>\n    \n    <table style=\"width: 100%; margin-bottom: 20px;\">\n        <tr>\n            <td style=\"width: 50%;\"><b>CSA:</b> {{ frappe.db.get_value(\"Employee\", doc.csa, \"employee_name\") or doc.csa }}</td>\n            <td style=\"width: 50%; text-align: right;\"><b>Date/Time:</b> {{ frappe.utils.format_datetime(doc.timestamp) }}</td>\n        </tr>\n        <tr>\n            <td style=\"width: 50%;\"><b>Manager:</b> {{ frappe.db.get_value(\"User\", doc.manager, \"full_name\") or doc.manager }}</td>\n            <td style=\"width: 50%; text-align: right;\"><b>Status:</b> {{ doc.status }}</td>\n        </tr>\n    </table>\n    \n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\n        <thead>\n            <tr style=\"background-color: #f3f4f6;\">\n                <th style=\"padding: 10px; border: 1px solid #ddd; text-align: left;\" colspan=\"2\">1. Sales & Liabilities (Expected from CSA)</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Meter Sales</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ doc.get_formatted(\"meter_sales\") }}</td></tr>\n            <tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Inventory Sales</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ doc.get_formatted(\"inventory_sales\") }}</td></tr>\n            <tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Greasing Sales</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ doc.get_formatted(\"greasing_sales\") }}</td></tr>\n            <tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Customer Payments</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ doc.get_formatted(\"customer_payments\") }}</td></tr>\n            <tr style=\"font-weight: bold; background-color: #f9fafb;\"><td style=\"padding: 8px; border: 1px solid #ddd;\">Total Liabilities</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ doc.get_formatted(\"total_liabilities\") }}</td></tr>\n        </tbody>\n    </table>\n    \n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\n        <thead>\n            <tr style=\"background-color: #f3f4f6;\">\n                <th style=\"padding: 10px; border: 1px solid #ddd; text-align: left;\" colspan=\"2\">2. Deductions (Non-Cash Payments)</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr><td style=\"padding: 8px; border: 1px solid #ddd;\">M-Pesa</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ doc.get_formatted(\"mpesa\") }}</td></tr>\n            <tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Credit Invoices</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ doc.get_formatted(\"invoices\") }}</td></tr>\n            <tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Card Payments</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ doc.get_formatted(\"cards\") }}</td></tr>\n            <tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Expenses</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ doc.get_formatted(\"expenses\") }}</td></tr>\n            <tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Return To Tank</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ doc.get_formatted(\"rtt_deductions\") }}</td></tr>\n            <tr style=\"font-weight: bold; background-color: #f9fafb;\"><td style=\"padding: 8px; border: 1px solid #ddd;\">Total Deductions</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ doc.get_formatted(\"total_deductions\") }}</td></tr>\n        </tbody>\n    </table>\n    \n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 30px;\">\n        <thead>\n            <tr style=\"background-color: #e5e7eb;\">\n                <th style=\"padding: 12px; border: 1px solid #d1d5db; text-align: left;\" colspan=\"2\">3. Final Reconciliation</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr style=\"font-size: 1.1em;\"><td style=\"padding: 10px; border: 1px solid #ddd;\"><b>Expected Cash (Liabilities - Deductions)</b></td><td style=\"padding: 10px; border: 1px solid #ddd; text-align: right;\"><b>{{ doc.get_formatted(\"expected_cash\") }}</b></td></tr>\n            <tr style=\"font-size: 1.1em;\"><td style=\"padding: 10px; border: 1px solid #ddd;\"><b>Actual Cash Submitted</b></td><td style=\"padding: 10px; border: 1px solid #ddd; text-align: right;\"><b>{{ doc.get_formatted(\"actual_cash\") }}</b></td></tr>\n            <tr style=\"font-size: 1.2em; font-weight: bold; color: {% if doc.variance < 0 %}#dc2626{% else %}#16a34a{% endif %};\">\n                <td style=\"padding: 10px; border: 1px solid #ddd;\">Variance</td>\n                <td style=\"padding: 10px; border: 1px solid #ddd; text-align: right;\">{{ doc.get_formatted(\"variance\") }}</td>\n            </tr>\n        </tbody>\n    </table>\n    \n    <div style=\"margin-top: 50px; display: flex; justify-content: space-between;\">\n        <div style=\"width: 45%; border-top: 1px solid #333; padding-top: 10px; text-align: center;\">\n            <p style=\"margin: 0;\"><b>CSA Signature</b></p>\n            <p style=\"margin: 5px 0 0 0; font-size: 0.9em; color: #666;\">Date: ________________</p>\n        </div>\n        <div style=\"width: 45%; border-top: 1px solid #333; padding-top: 10px; text-align: center;\">\n            <p style=\"margin: 0;\"><b>Manager Signature</b></p>\n            <p style=\"margin: 5px 0 0 0; font-size: 0.9em; color: #666;\">Date: ________________</p>\n        </div>\n    </div>\n</div>"
}
