{
 "align_labels_right": 0,
 "custom_format": 1,
 "doc_type": "Shift",
 "docstatus": 0,
 "doctype": "Print Format",
 "html": "<style>\n@media print {\n    @page { size: A4 portrait; margin: 4mm 6mm 4mm 6mm; }\n    html, body { margin: 0 !important; padding: 0 !important; background: #ffffff !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; font-size: 10px !important; }\n    .print-format, .compact-signoff-wrap { padding: 0 !important; margin: 0 !important; }\n}\n.compact-signoff-wrap { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; width: 100%; max-width: 820px; margin: 0 auto; padding: 4px 6px; color: #0f172a; background: #ffffff; line-height: 1.2; }\n.sec-hdr { background: #0f172a; color: #ffffff; padding: 3px 8px; font-size: 10.5px; font-weight: 800; letter-spacing: 0.3px; text-transform: uppercase; border-radius: 3px 3px 0 0; }\n.sec-table { width: 100%; border-collapse: collapse; font-size: 9.5px; border: 1px solid #cbd5e1; margin-bottom: 6px; }\n.sec-table th { background-color: #f1f5f9; color: #334155; font-size: 8.5px; text-transform: uppercase; font-weight: 800; padding: 2.5px 5px; border: 1px solid #cbd5e1; }\n.sec-table td { padding: 2px 5px; border: 1px solid #cbd5e1; }\n.sec-table .total-row { background: #e2e8f0; font-weight: 800; font-size: 9.5px; }\n</style>\n\n<div class=\"compact-signoff-wrap\">\n    <div style=\"text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 4px; margin-bottom: 6px;\">\n        <div style=\"font-size: 14px; font-weight: 900; letter-spacing: -0.2px; text-transform: uppercase; color: #0f172a; margin: 0 0 1px 0;\">\n            Consolidated CSA Cash &amp; Operations Sign-Off\n        </div>\n        <div style=\"display: inline-block; background: #0f172a; color: #ffffff; padding: 2px 14px; border-radius: 3px; margin: 1px 0; font-size: 12px; font-weight: 900; letter-spacing: 0.4px; text-transform: uppercase;\">\n            SHIFT: {{ doc.get_formatted(\"shift_date\") }} &bull; {{ (doc.shift_template or \"\") | upper }}\n        </div>\n        <div style=\"font-size: 9.5px; font-weight: 700; color: #475569; margin-top: 1px;\">\n            STATION: <span style=\"color: #0f172a;\">{{ (doc.station or \"\") | upper }}</span> &nbsp;|&nbsp; \n            SHIFT ID: <span style=\"color: #0f172a;\">{{ doc.name }}</span> &nbsp;|&nbsp;\n            STATUS: <span style=\"color: {% if doc.status == 'Closed' %}#16a34a{% else %}#ea580c{% endif %}; font-weight: 800;\">{{ doc.status | upper }}</span>\n        </div>\n    </div>\n\n    {% set pg_summary = doc.get_pump_group_sales_summary() if doc.get_pump_group_sales_summary else [] %}\n\n    <!-- 1. CSA CASH RECONCILIATION & SIGN-OFF -->\n    <div>\n        <div class=\"sec-hdr\">\n            1. CSA Cash Reconciliation &amp; Sign-Off\n        </div>\n        <table class=\"sec-table\">\n            <thead>\n                <tr>\n                    <th style=\"text-align: left;\">CSA Name</th>\n                    <th style=\"text-align: left; width: 13%;\">Pump Group</th>\n                    <th style=\"text-align: right; width: 13%;\">Fuel Sold (Lts)</th>\n                    <th style=\"text-align: right; width: 15%;\">Expected Cash (KES)</th>\n                    <th style=\"text-align: right; width: 15%;\">Actual Cash (KES)</th>\n                    <th style=\"text-align: right; width: 14%;\">Variance (KES)</th>\n                    <th style=\"text-align: center; width: 17%;\">CSA Signature</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% set recons = frappe.get_all(\"Shift Cash Reconciliation\", filters={\"shift\": doc.name}, fields=[\"csa\", \"expected_cash\", \"actual_cash\", \"variance\"], order_by=\"creation asc\") %}\n                {% if recons %}\n                    {% set ns = namespace(tot_exp=0, tot_act=0, tot_var=0, tot_fuel_lts=0) %}\n                    {% for r in recons %}\n                        {% set csa_pg = namespace(val=\"-\") %}\n                        {% for ac in (doc.assigned_csas or []) %}\n                            {% if ac.csa == r.csa %}\n                                {% set csa_pg.val = ac.pump_group %}\n                            {% endif %}\n                        {% endfor %}\n                        {% set csa_fuel = namespace(lts=0) %}\n                        {% for g in pg_summary %}\n                            {% if g.pump_group == csa_pg.val %}\n                                {% set csa_fuel.lts = g.total_liters %}\n                            {% endif %}\n                        {% endfor %}\n                        {% set ns.tot_fuel_lts = ns.tot_fuel_lts + csa_fuel.lts %}\n                        {% set ns.tot_exp = ns.tot_exp + r.expected_cash %}\n                        {% set ns.tot_act = ns.tot_act + r.actual_cash %}\n                        {% set ns.tot_var = ns.tot_var + r.variance %}\n                        <tr style=\"{% if loop.index % 2 == 0 %}background-color: #f8fafc;{% endif %}\">\n                            <td style=\"font-weight: 700;\">{{ frappe.db.get_value(\"Employee\", r.csa, \"employee_name\") or r.csa }}</td>\n                            <td style=\"color: #334155; font-weight: 600;\">{{ csa_pg.val or '-' }}</td>\n                            <td style=\"text-align: right; font-weight: 700; color: #1e3a8a;\">\n                                {% if csa_fuel.lts > 0 %}{{ \"{:,.2f}\".format(csa_fuel.lts) }}{% else %}-{% endif %}\n                            </td>\n                            <td style=\"text-align: right; font-weight: 600;\">{{ \"{:,.2f}\".format(r.expected_cash) }}</td>\n                            <td style=\"text-align: right; font-weight: 600;\">{{ \"{:,.2f}\".format(r.actual_cash) }}</td>\n                            <td style=\"text-align: right; font-weight: 800; color: {% if r.variance < 0 %}#dc2626{% elif r.variance > 0 %}#16a34a{% else %}#334155{% endif %};\">\n                                {{ \"{:,.2f}\".format(r.variance) }}\n                            </td>\n                            <td style=\"text-align: center; color: #94a3b8; font-size: 8px;\">\n                                _______________________\n                            </td>\n                        </tr>\n                    {% endfor %}\n                    <tr class=\"total-row\">\n                        <td colspan=\"2\" style=\"text-transform: uppercase;\">TOTAL CSA CASH &amp; FUEL</td>\n                        <td style=\"text-align: right; font-weight: 900; color: #1e3a8a;\">{{ \"{:,.2f}\".format(ns.tot_fuel_lts) }}</td>\n                        <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(ns.tot_exp) }}</td>\n                        <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(ns.tot_act) }}</td>\n                        <td style=\"text-align: right; color: {% if ns.tot_var < 0 %}#dc2626{% elif ns.tot_var > 0 %}#16a34a{% else %}#0f172a{% endif %};\">\n                            {{ \"{:,.2f}\".format(ns.tot_var) }}\n                        </td>\n                        <td></td>\n                    </tr>\n                {% else %}\n                    <tr><td colspan=\"7\" style=\"padding: 6px; text-align: center; color: #64748b;\">No CSA Reconciliations found for this shift.</td></tr>\n                {% endif %}\n            </tbody>\n        </table>\n    </div>\n\n    <!-- 2. PUMP GROUP FUEL SALES BREAKDOWN (LITRES) -->\n    <div>\n        <div class=\"sec-hdr\" style=\"background: #1e3a8a;\">\n            2. Pump Group Fuel Sales Summary (Litres)\n        </div>\n        <table class=\"sec-table\">\n            <thead>\n                <tr>\n                    <th style=\"text-align: left; width: 16%;\">Pump / Group</th>\n                    <th style=\"text-align: left; width: 30%;\">Assigned CSA(s)</th>\n                    <th style=\"text-align: right; width: 18%;\">Petrol / PMS (Lts)</th>\n                    <th style=\"text-align: right; width: 18%;\">Diesel / AGO (Lts)</th>\n                    <th style=\"text-align: right; width: 18%;\">Total Sales (Lts)</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% if pg_summary and pg_summary|length > 0 %}\n                    {% set pg_ns = namespace(tot_pms=0, tot_ago=0, tot_vol=0) %}\n                    {% for g in pg_summary %}\n                        {% set pg_ns.tot_pms = pg_ns.tot_pms + g.pms_liters %}\n                        {% set pg_ns.tot_ago = pg_ns.tot_ago + g.ago_liters %}\n                        {% set pg_ns.tot_vol = pg_ns.tot_vol + g.total_liters %}\n                        <tr style=\"{% if loop.index % 2 == 0 %}background-color: #f8fafc;{% endif %}\">\n                            <td style=\"font-weight: 700; color: #0f172a;\">{{ g.pump_group }}</td>\n                            <td style=\"font-weight: 600; color: #1e293b;\">{{ g.csas }}</td>\n                            <td style=\"text-align: right; font-weight: 600;\">{{ \"{:,.2f}\".format(g.pms_liters) }}</td>\n                            <td style=\"text-align: right; font-weight: 600;\">{{ \"{:,.2f}\".format(g.ago_liters) }}</td>\n                            <td style=\"text-align: right; font-weight: 800; color: #0f172a; background: #f8fafc;\">\n                                {{ \"{:,.2f}\".format(g.total_liters) }}\n                            </td>\n                        </tr>\n                    {% endfor %}\n                    <tr class=\"total-row\" style=\"background: #e2e8f0; font-weight: 800; border-top: 1.5px solid #0f172a;\">\n                        <td colspan=\"2\" style=\"text-transform: uppercase;\">TOTAL PUMP GROUP SALES (LTS)</td>\n                        <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(pg_ns.tot_pms) }}</td>\n                        <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(pg_ns.tot_ago) }}</td>\n                        <td style=\"text-align: right; color: #0f172a; font-weight: 900;\">{{ \"{:,.2f}\".format(pg_ns.tot_vol) }}</td>\n                    </tr>\n                {% else %}\n                    <tr><td colspan=\"5\" style=\"padding: 6px; text-align: center; color: #64748b;\">No pump group sales recorded.</td></tr>\n                {% endif %}\n            </tbody>\n        </table>\n    </div>\n\n    <!-- 3. PUMP NOZZLE READINGS & FUEL SALES -->\n    <div>\n        <div class=\"sec-hdr\" style=\"background: #1e293b;\">\n            3. Pump Nozzle Readings &amp; Fuel Sales (Litres)\n        </div>\n        <table class=\"sec-table\">\n            <thead>\n                <tr>\n                    <th style=\"text-align: left; width: 14%;\">Pump / Group</th>\n                    <th style=\"text-align: left; width: 16%;\">Nozzle Name</th>\n                    <th style=\"text-align: left; width: 18%;\">Fuel Product</th>\n                    <th style=\"text-align: right; width: 17%;\">Opening Meter (Lts)</th>\n                    <th style=\"text-align: right; width: 17%;\">Closing Meter (Lts)</th>\n                    <th style=\"text-align: right; width: 18%;\">Sales Volume (Lts)</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% if pg_summary and pg_summary|length > 0 %}\n                    {% set m_all = namespace(tot_liters=0, pms_liters=0, ago_liters=0) %}\n                    {% for g in pg_summary %}\n                        {% for nz in g.nozzles %}\n                            {% set m_all.tot_liters = m_all.tot_liters + nz.sales_qty %}\n                            {% if 'petrol' in nz.product|lower or 'pms' in nz.product|lower or 'super' in nz.product|lower or 'pms' in nz.nozzle|lower %}\n                                {% set m_all.pms_liters = m_all.pms_liters + nz.sales_qty %}\n                            {% else %}\n                                {% set m_all.ago_liters = m_all.ago_liters + nz.sales_qty %}\n                            {% endif %}\n                            <tr>\n                                <td style=\"font-weight: 600; color: #334155;\">{{ g.pump_group }}</td>\n                                <td style=\"font-weight: 700; color: #0f172a;\">{{ nz.nozzle }}</td>\n                                <td style=\"color: #475569;\">{{ nz.product or '-' }}</td>\n                                <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(nz.opening) }}</td>\n                                <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(nz.closing) }}</td>\n                                <td style=\"text-align: right; font-weight: 700; color: #0f172a; background: #f8fafc;\">\n                                    {{ \"{:,.2f}\".format(nz.sales_qty) }}\n                                </td>\n                            </tr>\n                        {% endfor %}\n                        <tr style=\"background: #f1f5f9; font-weight: 700; border-top: 1px solid #cbd5e1; border-bottom: 1px solid #cbd5e1;\">\n                            <td colspan=\"5\" style=\"text-align: left; color: #1e3a8a; font-size: 9px; padding-left: 8px;\">\n                                &#x25B8; SUBTOTAL {{ g.pump_group | upper }} (LTS) &nbsp; <span style=\"font-size: 8.5px; font-weight: 600; color: #64748b;\">(Assigned: {{ g.csas }})</span>\n                            </td>\n                            <td style=\"text-align: right; color: #1e3a8a; font-weight: 800;\">\n                                {{ \"{:,.2f}\".format(g.total_liters) }}\n                            </td>\n                        </tr>\n                    {% endfor %}\n                    {% if m_all.pms_liters > 0 %}\n                    <tr style=\"background: #e2e8f0; font-weight: 700;\">\n                        <td colspan=\"5\" style=\"text-align: left; color: #1e293b;\">TOTAL PETROL / PMS (LTS)</td>\n                        <td style=\"text-align: right; color: #0f172a;\">{{ \"{:,.2f}\".format(m_all.pms_liters) }}</td>\n                    </tr>\n                    {% endif %}\n                    {% if m_all.ago_liters > 0 %}\n                    <tr style=\"background: #e2e8f0; font-weight: 700;\">\n                        <td colspan=\"5\" style=\"text-align: left; color: #1e293b;\">TOTAL DIESEL / AGO (LTS)</td>\n                        <td style=\"text-align: right; color: #0f172a;\">{{ \"{:,.2f}\".format(m_all.ago_liters) }}</td>\n                    </tr>\n                    {% endif %}\n                    <tr class=\"total-row\" style=\"background: #cbd5e1; font-weight: 900; border-top: 1.5px solid #0f172a;\">\n                        <td colspan=\"5\" style=\"text-transform: uppercase;\">GRAND TOTAL NOZZLE SALES (LITRES)</td>\n                        <td style=\"text-align: right; color: #0f172a; font-weight: 900;\">{{ \"{:,.2f}\".format(m_all.tot_liters) }}</td>\n                    </tr>\n                {% else %}\n                    <tr><td colspan=\"6\" style=\"padding: 6px; text-align: center; color: #64748b;\">No nozzle readings recorded.</td></tr>\n                {% endif %}\n            </tbody>\n        </table>\n    </div>\n\n    <!-- 4. WET STOCK INFORMATION (DIPS) -->\n    <div>\n        <div class=\"sec-hdr\" style=\"background: #059669;\">\n            4. Wet Stock Information (Dips) Summary\n        </div>\n        <table class=\"sec-table\">\n            <thead>\n                <tr style=\"background-color: #ecfdf5; color: #065f46;\">\n                    <th style=\"text-align: left; width: 22%;\">Tank / Product</th>\n                    <th style=\"text-align: right; width: 13%;\">Opening Dip (Lts)</th>\n                    <th style=\"text-align: right; width: 13%;\">Purchases (Lts)</th>\n                    <th style=\"text-align: right; width: 13%;\">Closing Dip (Lts)</th>\n                    <th style=\"text-align: right; width: 13%;\">Tank Sales (Lts)</th>\n                    <th style=\"text-align: right; width: 13%;\">Meter Sales (Lts)</th>\n                    <th style=\"text-align: right; width: 13%;\">Variance (Lts)</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% set dips_summary = doc.get_wet_stock_summary() if doc.get_wet_stock_summary else [] %}\n                {% if dips_summary and dips_summary|length > 0 %}\n                    {% set d_ns = namespace(tot_open=0, tot_purch=0, tot_close=0, tot_tank_sales=0, tot_meter_sales=0, tot_var=0) %}\n                    {% for d in dips_summary %}\n                        {% set d_ns.tot_open = d_ns.tot_open + (d.opening_dip or 0) %}\n                        {% set d_ns.tot_purch = d_ns.tot_purch + (d.injected_purchases or 0) %}\n                        {% set d_ns.tot_close = d_ns.tot_close + (d.closing_dip or 0) %}\n                        {% set d_ns.tot_tank_sales = d_ns.tot_tank_sales + (d.sales_quantity or 0) %}\n                        {% set d_ns.tot_meter_sales = d_ns.tot_meter_sales + (d.meter_sales or 0) %}\n                        {% set d_ns.tot_var = d_ns.tot_var + (d.variance or 0) %}\n                        <tr style=\"{% if loop.index % 2 == 0 %}background-color: #f8fafc;{% endif %}\">\n                            <td style=\"font-weight: 700; color: #0f172a;\">{{ d.fuel_tank }}</td>\n                            <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(d.opening_dip or 0) }}</td>\n                            <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(d.injected_purchases or 0) }}</td>\n                            <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(d.closing_dip or 0) }}</td>\n                            <td style=\"text-align: right; font-weight: 600;\">{{ \"{:,.2f}\".format(d.sales_quantity or 0) }}</td>\n                            <td style=\"text-align: right; font-weight: 600;\">{{ \"{:,.2f}\".format(d.meter_sales or 0) }}</td>\n                            <td style=\"text-align: right; font-weight: 800; color: {% if d.variance < 0 %}#dc2626{% elif d.variance > 0 %}#16a34a{% else %}#334155{% endif %};\">\n                                {{ \"{:,.2f}\".format(d.variance or 0) }}\n                            </td>\n                        </tr>\n                    {% endfor %}\n                    <tr class=\"total-row\" style=\"background: #e2e8f0; font-weight: 800; font-size: 9.5px; border-top: 1.5px solid #0f172a;\">\n                        <td style=\"text-transform: uppercase;\">GRAND TOTAL WET STOCK (LTS)</td>\n                        <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(d_ns.tot_open) }}</td>\n                        <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(d_ns.tot_purch) }}</td>\n                        <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(d_ns.tot_close) }}</td>\n                        <td style=\"text-align: right; font-weight: 900; color: #0f172a;\">{{ \"{:,.2f}\".format(d_ns.tot_tank_sales) }}</td>\n                        <td style=\"text-align: right; font-weight: 900; color: #0f172a;\">{{ \"{:,.2f}\".format(d_ns.tot_meter_sales) }}</td>\n                        <td style=\"text-align: right; font-weight: 900; color: {% if d_ns.tot_var < 0 %}#dc2626{% elif d_ns.tot_var > 0 %}#16a34a{% else %}#0f172a{% endif %};\">\n                            {{ \"{:,.2f}\".format(d_ns.tot_var) }}\n                        </td>\n                    </tr>\n                {% elif doc.dip_stick_readings and doc.dip_stick_readings|length > 0 %}\n                    {% set fb_ns = namespace(tot_open=0, tot_purch=0, tot_close=0, tot_tank_sales=0, tot_meter_sales=0, tot_var=0) %}\n                    {% for d in doc.dip_stick_readings %}\n                        {% set open_v = d.opening_dip or 0 %}\n                        {% set close_v = d.closing_dip or 0 %}\n                        {% set tank_meters = namespace(sales=0) %}\n                        {% for m in (doc.pump_meter_readings or []) %}\n                            {% set nz_t = frappe.db.get_value(\"Pump Nozzle\", m.pump_nozzle, \"fuel_tank\") %}\n                            {% if nz_t == d.fuel_tank %}\n                                {% set m_qty = m.sales_quantity_electronic or (m.closing_electronic_meter - m.opening_electronic_meter) %}\n                                {% if m_qty > 0 %}{% set tank_meters.sales = tank_meters.sales + m_qty %}{% endif %}\n                            {% endif %}\n                        {% endfor %}\n                        {% set purchases_qty = 0 %}\n                        {% set tank_sales = open_v + purchases_qty - close_v %}\n                        {% if tank_sales < 0 %}{% set tank_sales = 0 %}{% endif %}\n                        {% set var_v = tank_meters.sales - tank_sales %}\n                        {% set fb_ns.tot_open = fb_ns.tot_open + open_v %}\n                        {% set fb_ns.tot_purch = fb_ns.tot_purch + purchases_qty %}\n                        {% set fb_ns.tot_close = fb_ns.tot_close + close_v %}\n                        {% set fb_ns.tot_tank_sales = fb_ns.tot_tank_sales + tank_sales %}\n                        {% set fb_ns.tot_meter_sales = fb_ns.tot_meter_sales + tank_meters.sales %}\n                        {% set fb_ns.tot_var = fb_ns.tot_var + var_v %}\n                        <tr style=\"{% if loop.index % 2 == 0 %}background-color: #f8fafc;{% endif %}\">\n                            <td style=\"font-weight: 700; color: #0f172a;\">{{ d.fuel_tank }}</td>\n                            <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(open_v) }}</td>\n                            <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(purchases_qty) }}</td>\n                            <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(close_v) }}</td>\n                            <td style=\"text-align: right; font-weight: 600;\">{{ \"{:,.2f}\".format(tank_sales) }}</td>\n                            <td style=\"text-align: right; font-weight: 600;\">{{ \"{:,.2f}\".format(tank_meters.sales) }}</td>\n                            <td style=\"text-align: right; font-weight: 800; color: {% if var_v < 0 %}#dc2626{% elif var_v > 0 %}#16a34a{% else %}#334155{% endif %};\">\n                                {{ \"{:,.2f}\".format(var_v) }}\n                            </td>\n                        </tr>\n                    {% endfor %}\n                    <tr class=\"total-row\" style=\"background: #e2e8f0; font-weight: 800; font-size: 9.5px; border-top: 1.5px solid #0f172a;\">\n                        <td style=\"text-transform: uppercase;\">GRAND TOTAL WET STOCK (LTS)</td>\n                        <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(fb_ns.tot_open) }}</td>\n                        <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(fb_ns.tot_purch) }}</td>\n                        <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(fb_ns.tot_close) }}</td>\n                        <td style=\"text-align: right; font-weight: 900; color: #0f172a;\">{{ \"{:,.2f}\".format(fb_ns.tot_tank_sales) }}</td>\n                        <td style=\"text-align: right; font-weight: 900; color: #0f172a;\">{{ \"{:,.2f}\".format(fb_ns.tot_meter_sales) }}</td>\n                        <td style=\"text-align: right; font-weight: 900; color: {% if fb_ns.tot_var < 0 %}#dc2626{% elif fb_ns.tot_var > 0 %}#16a34a{% else %}#0f172a{% endif %};\">\n                            {{ \"{:,.2f}\".format(fb_ns.tot_var) }}\n                        </td>\n                    </tr>\n                {% else %}\n                    <tr><td colspan=\"7\" style=\"padding: 6px; text-align: center; color: #64748b;\">No tank dips recorded for this shift.</td></tr>\n                {% endif %}\n            </tbody>\n        </table>\n    </div>\n\n    <!-- 5. SIGNATURES & VERIFICATION -->\n    <div style=\"margin-top: 8px; display: flex; justify-content: space-between; page-break-inside: avoid;\">\n        <div style=\"width: 47%; border-top: 1.5px solid #0f172a; padding-top: 3px; text-align: left;\">\n            <p style=\"margin: 0; font-weight: 800; font-size: 9.5px; text-transform: uppercase;\">Manager / Head CSA Sign-Off</p>\n            <p style=\"margin: 1.5px 0 0 0; font-size: 8.5px; color: #475569;\">Name: {{ frappe.db.get_value(\"User\", doc.head_csa, \"full_name\") or doc.head_csa or \"________________\" }}</p>\n            <p style=\"margin: 1.5px 0 0 0; font-size: 8.5px; color: #475569;\">Signature: ______________________ &nbsp;&nbsp; Date: ____________</p>\n        </div>\n        <div style=\"width: 47%; border-top: 1.5px solid #0f172a; padding-top: 3px; text-align: left;\">\n            <p style=\"margin: 0; font-weight: 800; font-size: 9.5px; text-transform: uppercase;\">Station Auditor / Owner Review</p>\n            <p style=\"margin: 1.5px 0 0 0; font-size: 8.5px; color: #475569;\">Name: __________________________</p>\n            <p style=\"margin: 1.5px 0 0 0; font-size: 8.5px; color: #475569;\">Signature: ______________________ &nbsp;&nbsp; Date: ____________</p>\n        </div>\n    </div>\n</div>",
 "line_breaks": 0,
 "module": "Fuel Management",
 "name": "Consolidated CSA Sign-Off",
 "print_format_builder": 0,
 "show_section_headings": 0,
 "standard": "Yes"
}