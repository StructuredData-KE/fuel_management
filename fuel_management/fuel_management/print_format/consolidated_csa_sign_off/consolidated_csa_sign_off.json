{
 "align_labels_right": 0,
 "custom_format": 1,
 "doc_type": "Shift",
 "docstatus": 0,
 "doctype": "Print Format",
 "html": "<style>\n@media print {\n    @page {\n        size: A4 portrait;\n        margin: 4mm 6mm 4mm 6mm;\n    }\n    html, body {\n        margin: 0 !important;\n        padding: 0 !important;\n        background: #ffffff !important;\n        -webkit-print-color-adjust: exact !important;\n        print-color-adjust: exact !important;\n        font-size: 10px !important;\n    }\n    .print-format {\n        padding: 0 !important;\n        margin: 0 !important;\n    }\n    .compact-signoff-wrap {\n        padding: 0 !important;\n    }\n}\n.compact-signoff-wrap {\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n    width: 100%;\n    max-width: 820px;\n    margin: 0 auto;\n    padding: 4px 6px;\n    color: #0f172a;\n    background: #ffffff;\n    line-height: 1.2;\n}\n.sec-hdr {\n    background: #0f172a;\n    color: #ffffff;\n    padding: 3px 8px;\n    font-size: 10.5px;\n    font-weight: 800;\n    letter-spacing: 0.3px;\n    text-transform: uppercase;\n    border-radius: 3px 3px 0 0;\n}\n.sec-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 9.5px;\n    border: 1px solid #cbd5e1;\n    margin-bottom: 6px;\n}\n.sec-table th {\n    background-color: #f1f5f9;\n    color: #334155;\n    font-size: 8.5px;\n    text-transform: uppercase;\n    font-weight: 800;\n    padding: 2.5px 5px;\n    border: 1px solid #cbd5e1;\n}\n.sec-table td {\n    padding: 2px 5px;\n    border: 1px solid #cbd5e1;\n}\n.sec-table .total-row {\n    background: #e2e8f0;\n    font-weight: 800;\n    font-size: 9.5px;\n}\n</style>\n\n<div class=\"compact-signoff-wrap\">\n    <!-- HEADER -->\n    <div style=\"text-align: center; border-bottom: 2px solid #0f172a; padding-bottom: 4px; margin-bottom: 6px;\">\n        <div style=\"font-size: 14px; font-weight: 900; letter-spacing: -0.2px; text-transform: uppercase; color: #0f172a; margin: 0 0 1px 0;\">\n            Consolidated CSA Cash &amp; Operations Sign-Off\n        </div>\n        \n        <!-- BIG BOLD SHIFT BANNER -->\n        <div style=\"display: inline-block; background: #0f172a; color: #ffffff; padding: 2px 14px; border-radius: 3px; margin: 1px 0; font-size: 12px; font-weight: 900; letter-spacing: 0.4px; text-transform: uppercase;\">\n            SHIFT: {{ doc.get_formatted(\"shift_date\") }} &bull; {{ (doc.shift_template or \"\") | upper }}\n        </div>\n        \n        <div style=\"font-size: 9.5px; font-weight: 700; color: #475569; margin-top: 1px;\">\n            STATION: <span style=\"color: #0f172a;\">{{ (doc.station or \"\") | upper }}</span> &nbsp;|&nbsp; \n            SHIFT ID: <span style=\"color: #0f172a;\">{{ doc.name }}</span> &nbsp;|&nbsp;\n            STATUS: <span style=\"color: {% if doc.status == 'Closed' %}#16a34a{% else %}#ea580c{% endif %}; font-weight: 800;\">{{ doc.status | upper }}</span>\n        </div>\n    </div>\n\n    <!-- 1. CSA CASH RECONCILIATION & SIGN-OFF -->\n    <div>\n        <div class=\"sec-hdr\">\n            1. CSA Cash Reconciliation &amp; Sign-Off\n        </div>\n        <table class=\"sec-table\">\n            <thead>\n                <tr>\n                    <th style=\"text-align: left;\">CSA Name</th>\n                    <th style=\"text-align: left; width: 14%;\">Pump Group</th>\n                    <th style=\"text-align: right; width: 17%;\">Expected Cash (KES)</th>\n                    <th style=\"text-align: right; width: 17%;\">Actual Cash (KES)</th>\n                    <th style=\"text-align: right; width: 15%;\">Variance (KES)</th>\n                    <th style=\"text-align: center; width: 20%;\">CSA Signature</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% set recons = frappe.get_all(\"Shift Cash Reconciliation\", filters={\"shift\": doc.name}, fields=[\"csa\", \"expected_cash\", \"actual_cash\", \"variance\"], order_by=\"creation asc\") %}\n                {% if recons %}\n                    {% set ns = namespace(tot_exp=0, tot_act=0, tot_var=0) %}\n                    {% for r in recons %}\n                        {% set csa_pg = namespace(val=\"-\") %}\n                        {% for ac in (doc.assigned_csas or []) %}\n                            {% if ac.csa == r.csa %}\n                                {% set csa_pg.val = ac.pump_group %}\n                            {% endif %}\n                        {% endfor %}\n                        {% set ns.tot_exp = ns.tot_exp + r.expected_cash %}\n                        {% set ns.tot_act = ns.tot_act + r.actual_cash %}\n                        {% set ns.tot_var = ns.tot_var + r.variance %}\n                        <tr style=\"{% if loop.index % 2 == 0 %}background-color: #f8fafc;{% endif %}\">\n                            <td style=\"font-weight: 700;\">{{ frappe.db.get_value(\"Employee\", r.csa, \"employee_name\") or r.csa }}</td>\n                            <td style=\"color: #334155; font-weight: 600;\">{{ csa_pg.val or '-' }}</td>\n                            <td style=\"text-align: right; font-weight: 600;\">{{ \"{:,.2f}\".format(r.expected_cash) }}</td>\n                            <td style=\"text-align: right; font-weight: 600;\">{{ \"{:,.2f}\".format(r.actual_cash) }}</td>\n                            <td style=\"text-align: right; font-weight: 800; color: {% if r.variance < 0 %}#dc2626{% elif r.variance > 0 %}#16a34a{% else %}#334155{% endif %};\">\n                                {{ \"{:,.2f}\".format(r.variance) }}\n                            </td>\n                            <td style=\"text-align: center; color: #94a3b8; font-size: 8px;\">\n                                _______________________\n                            </td>\n                        </tr>\n                    {% endfor %}\n                    <tr class=\"total-row\">\n                        <td colspan=\"2\" style=\"text-transform: uppercase;\">TOTAL CSA CASH</td>\n                        <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(ns.tot_exp) }}</td>\n                        <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(ns.tot_act) }}</td>\n                        <td style=\"text-align: right; color: {% if ns.tot_var < 0 %}#dc2626{% elif ns.tot_var > 0 %}#16a34a{% else %}#0f172a{% endif %};\">\n                            {{ \"{:,.2f}\".format(ns.tot_var) }}\n                        </td>\n                        <td></td>\n                    </tr>\n                {% else %}\n                    <tr><td colspan=\"6\" style=\"padding: 6px; text-align: center; color: #64748b;\">No CSA Reconciliations found for this shift.</td></tr>\n                {% endif %}\n            </tbody>\n        </table>\n    </div>\n\n    <!-- 2. NOZZLE READINGS & PUMP SALES -->\n    <div>\n        <div class=\"sec-hdr\" style=\"background: #1e293b;\">\n            2. Pump Nozzle Readings &amp; Fuel Sales (Litres)\n        </div>\n        <table class=\"sec-table\">\n            <thead>\n                <tr>\n                    <th style=\"text-align: left;\">Pump / Group</th>\n                    <th style=\"text-align: left;\">Nozzle Name</th>\n                    <th style=\"text-align: left;\">Fuel Product</th>\n                    <th style=\"text-align: right;\">Opening Meter (Lts)</th>\n                    <th style=\"text-align: right;\">Closing Meter (Lts)</th>\n                    <th style=\"text-align: right;\">Sales Volume (Lts)</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% set meter_readings = doc.pump_meter_readings or [] %}\n                {% if meter_readings %}\n                    {% set m_ns = namespace(tot_liters=0, pms_liters=0, ago_liters=0, other_liters=0) %}\n                    {% for m in meter_readings %}\n                        {% set nz_info = frappe.db.get_value(\"Pump Nozzle\", m.pump_nozzle, [\"pump_group\", \"fuel_tank\"], as_dict=True) %}\n                        {% set tank_info = frappe.db.get_value(\"Fuel Tank\", nz_info.fuel_tank, \"fuel_product\") if nz_info else \"\" %}\n                        {% set prod_name = tank_info or nz_info.fuel_tank or \"\" %}\n                        {% set sales_qty = m.sales_quantity_electronic or (m.closing_electronic_meter - m.opening_electronic_meter) %}\n                        {% if sales_qty < 0 %}{% set sales_qty = 0 %}{% endif %}\n                        {% set m_ns.tot_liters = m_ns.tot_liters + sales_qty %}\n                        \n                        {% if 'petrol' in prod_name|lower or 'pms' in prod_name|lower or 'super' in prod_name|lower or 'pms' in m.pump_nozzle|lower %}\n                            {% set m_ns.pms_liters = m_ns.pms_liters + sales_qty %}\n                        {% elif 'diesel' in prod_name|lower or 'ago' in prod_name|lower or 'ago' in m.pump_nozzle|lower %}\n                            {% set m_ns.ago_liters = m_ns.ago_liters + sales_qty %}\n                        {% else %}\n                            {% set m_ns.other_liters = m_ns.other_liters + sales_qty %}\n                        {% endif %}\n                        \n                        <tr style=\"{% if loop.index % 2 == 0 %}background-color: #f8fafc;{% endif %}\">\n                            <td style=\"font-weight: 600;\">{{ nz_info.pump_group if nz_info else '-' }}</td>\n                            <td style=\"font-weight: 700; color: #0f172a;\">{{ m.pump_nozzle }}</td>\n                            <td style=\"color: #475569;\">{{ prod_name or '-' }}</td>\n                            <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(m.opening_electronic_meter or 0) }}</td>\n                            <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(m.closing_electronic_meter or 0) }}</td>\n                            <td style=\"text-align: right; font-weight: 800; color: #0f172a; background: #f8fafc;\">\n                                {{ \"{:,.2f}\".format(sales_qty) }}\n                            </td>\n                        </tr>\n                    {% endfor %}\n                    \n                    <!-- Subtotals -->\n                    {% if m_ns.pms_liters > 0 %}\n                    <tr style=\"background: #f1f5f9; font-weight: 700;\">\n                        <td colspan=\"5\" style=\"text-align: left; color: #1e293b;\">TOTAL PETROL / PMS (LTS)</td>\n                        <td style=\"text-align: right; color: #0f172a;\">{{ \"{:,.2f}\".format(m_ns.pms_liters) }}</td>\n                    </tr>\n                    {% endif %}\n                    {% if m_ns.ago_liters > 0 %}\n                    <tr style=\"background: #f1f5f9; font-weight: 700;\">\n                        <td colspan=\"5\" style=\"text-align: left; color: #1e293b;\">TOTAL DIESEL / AGO (LTS)</td>\n                        <td style=\"text-align: right; color: #0f172a;\">{{ \"{:,.2f}\".format(m_ns.ago_liters) }}</td>\n                    </tr>\n                    {% endif %}\n                    {% if m_ns.other_liters > 0 %}\n                    <tr style=\"background: #f1f5f9; font-weight: 700;\">\n                        <td colspan=\"5\" style=\"text-align: left; color: #1e293b;\">TOTAL OTHER PRODUCTS (LTS)</td>\n                        <td style=\"text-align: right; color: #0f172a;\">{{ \"{:,.2f}\".format(m_ns.other_liters) }}</td>\n                    </tr>\n                    {% endif %}\n                    <tr class=\"total-row\">\n                        <td colspan=\"5\" style=\"text-transform: uppercase;\">GRAND TOTAL NOZZLE SALES (LITRES)</td>\n                        <td style=\"text-align: right; color: #0f172a;\">{{ \"{:,.2f}\".format(m_ns.tot_liters) }}</td>\n                    </tr>\n                {% else %}\n                    <tr><td colspan=\"6\" style=\"padding: 6px; text-align: center; color: #64748b;\">No nozzle readings recorded.</td></tr>\n                {% endif %}\n            </tbody>\n        </table>\n    </div>\n\n    <!-- 3. WET STOCK INFORMATION (DIPS) -->\n    <div>\n        <div class=\"sec-hdr\" style=\"background: #059669;\">\n            3. Wet Stock Information (Dips) Summary\n        </div>\n        <table class=\"sec-table\">\n            <thead>\n                <tr style=\"background-color: #ecfdf5; color: #065f46;\">\n                    <th style=\"text-align: left;\">Tank / Product</th>\n                    <th style=\"text-align: right;\">Opening Dip (Lts)</th>\n                    <th style=\"text-align: right;\">Purchases (Lts)</th>\n                    <th style=\"text-align: right;\">Closing Dip (Lts)</th>\n                    <th style=\"text-align: right;\">Tank Sales (Lts)</th>\n                    <th style=\"text-align: right;\">Meter Sales (Lts)</th>\n                    <th style=\"text-align: right;\">Variance (Lts)</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% set dips_summary = doc.get_wet_stock_summary() if doc.get_wet_stock_summary else [] %}\n                {% if dips_summary and dips_summary|length > 0 %}\n                    {% for d in dips_summary %}\n                        <tr style=\"{% if loop.index % 2 == 0 %}background-color: #f8fafc;{% endif %}\">\n                            <td style=\"font-weight: 700; color: #0f172a;\">{{ d.fuel_tank }}</td>\n                            <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(d.opening_dip or 0) }}</td>\n                            <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(d.injected_purchases or 0) }}</td>\n                            <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(d.closing_dip or 0) }}</td>\n                            <td style=\"text-align: right; font-weight: 600;\">{{ \"{:,.2f}\".format(d.sales_quantity or 0) }}</td>\n                            <td style=\"text-align: right; font-weight: 600;\">{{ \"{:,.2f}\".format(d.meter_sales or 0) }}</td>\n                            <td style=\"text-align: right; font-weight: 800; color: {% if d.variance < 0 %}#dc2626{% elif d.variance > 0 %}#16a34a{% else %}#334155{% endif %};\">\n                                {{ \"{:,.2f}\".format(d.variance or 0) }}\n                            </td>\n                        </tr>\n                    {% endfor %}\n                {% elif doc.dip_stick_readings and doc.dip_stick_readings|length > 0 %}\n                    {% for d in doc.dip_stick_readings %}\n                        {% set open_v = d.opening_dip or 0 %}\n                        {% set close_v = d.closing_dip or 0 %}\n                        {% set tank_meters = namespace(sales=0) %}\n                        {% for m in (doc.pump_meter_readings or []) %}\n                            {% set nz_t = frappe.db.get_value(\"Pump Nozzle\", m.pump_nozzle, \"fuel_tank\") %}\n                            {% if nz_t == d.fuel_tank %}\n                                {% set m_qty = m.sales_quantity_electronic or (m.closing_electronic_meter - m.opening_electronic_meter) %}\n                                {% if m_qty > 0 %}{% set tank_meters.sales = tank_meters.sales + m_qty %}{% endif %}\n                            {% endif %}\n                        {% endfor %}\n                        {% set purchases_qty = 0 %}\n                        {% set tank_sales = open_v + purchases_qty - close_v %}\n                        {% if tank_sales < 0 %}{% set tank_sales = 0 %}{% endif %}\n                        {% set var_v = tank_meters.sales - tank_sales %}\n                        <tr style=\"{% if loop.index % 2 == 0 %}background-color: #f8fafc;{% endif %}\">\n                            <td style=\"font-weight: 700; color: #0f172a;\">{{ d.fuel_tank }}</td>\n                            <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(open_v) }}</td>\n                            <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(purchases_qty) }}</td>\n                            <td style=\"text-align: right;\">{{ \"{:,.2f}\".format(close_v) }}</td>\n                            <td style=\"text-align: right; font-weight: 600;\">{{ \"{:,.2f}\".format(tank_sales) }}</td>\n                            <td style=\"text-align: right; font-weight: 600;\">{{ \"{:,.2f}\".format(tank_meters.sales) }}</td>\n                            <td style=\"text-align: right; font-weight: 800; color: {% if var_v < 0 %}#dc2626{% elif var_v > 0 %}#16a34a{% else %}#334155{% endif %};\">\n                                {{ \"{:,.2f}\".format(var_v) }}\n                            </td>\n                        </tr>\n                    {% endfor %}\n                {% else %}\n                    <tr><td colspan=\"7\" style=\"padding: 6px; text-align: center; color: #64748b;\">No tank dips recorded for this shift.</td></tr>\n                {% endif %}\n            </tbody>\n        </table>\n    </div>\n\n    <!-- 4. SIGNATURES & VERIFICATION -->\n    <div style=\"margin-top: 8px; display: flex; justify-content: space-between; page-break-inside: avoid;\">\n        <div style=\"width: 47%; border-top: 1.5px solid #0f172a; padding-top: 3px; text-align: left;\">\n            <p style=\"margin: 0; font-weight: 800; font-size: 9.5px; text-transform: uppercase;\">Manager / Head CSA Sign-Off</p>\n            <p style=\"margin: 1.5px 0 0 0; font-size: 8.5px; color: #475569;\">Name: {{ frappe.db.get_value(\"User\", doc.head_csa, \"full_name\") or doc.head_csa or \"________________\" }}</p>\n            <p style=\"margin: 1.5px 0 0 0; font-size: 8.5px; color: #475569;\">Signature: ______________________ &nbsp;&nbsp; Date: ____________</p>\n        </div>\n        <div style=\"width: 47%; border-top: 1.5px solid #0f172a; padding-top: 3px; text-align: left;\">\n            <p style=\"margin: 0; font-weight: 800; font-size: 9.5px; text-transform: uppercase;\">Station Auditor / Owner Review</p>\n            <p style=\"margin: 1.5px 0 0 0; font-size: 8.5px; color: #475569;\">Name: __________________________</p>\n            <p style=\"margin: 1.5px 0 0 0; font-size: 8.5px; color: #475569;\">Signature: ______________________ &nbsp;&nbsp; Date: ____________</p>\n        </div>\n    </div>\n</div>",
 "line_breaks": 0,
 "module": "Fuel Management",
 "name": "Consolidated CSA Sign-Off",
 "print_format_builder": 0,
 "show_section_headings": 0,
 "standard": "Yes"
}