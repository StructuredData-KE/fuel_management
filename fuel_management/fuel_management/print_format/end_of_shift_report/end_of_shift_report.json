{
 "docstatus": 0,
 "doctype": "Print Format",
 "name": "End of Shift Report",
 "module": "Fuel Management",
 "doc_type": "Shift",
 "standard": "Yes",
 "custom_format": 1,
 "print_format_builder": 0,
 "align_labels_right": 0,
 "show_section_headings": 0,
 "line_breaks": 0,
 "html": "<div style=\"font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 20px; border: 1px solid #ddd;\">\n    <div style=\"text-align: center; border-bottom: 2px solid #333; padding-bottom: 10px; margin-bottom: 20px;\">\n        <h2>End of Shift Report</h2>\n        <h4>Shift: {{ doc.name }}</h4>\n    </div>\n    \n    <table style=\"width: 100%; margin-bottom: 20px;\">\n        <tr>\n            <td style=\"width: 50%;\"><b>Station:</b> {{ doc.station }}</td>\n            <td style=\"width: 50%; text-align: right;\"><b>Date:</b> {{ doc.get_formatted(\"shift_date\") }}</td>\n        </tr>\n        <tr>\n            <td style=\"width: 50%;\"><b>Manager:</b> {{ frappe.db.get_value(\"User\", doc.manager, \"full_name\") or doc.manager }}</td>\n            <td style=\"width: 50%; text-align: right;\"><b>Status:</b> {{ doc.status }}</td>\n        </tr>\n    </table>\n    \n    <h3 style=\"border-bottom: 1px solid #eee; padding-bottom: 5px;\">1. Financial Summary</h3>\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\n        <tbody>\n            <tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Expected Fuel Cash</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ doc.get_formatted(\"expected_cash\") }}</td></tr>\n            <tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Actual Fuel Cash</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ doc.get_formatted(\"actual_cash\") }}</td></tr>\n            <tr style=\"font-weight: bold; background-color: #f9fafb;\"><td style=\"padding: 8px; border: 1px solid #ddd;\">Fuel Variance</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right; color: {% if doc.cash_variance < 0 %}#dc2626{% else %}#16a34a{% endif %};\"><span style=\"color: {% if doc.cash_variance < 0 %}red{% else %}green{% endif %}\">{{ doc.get_formatted(\"cash_variance\") }}</span></td></tr>\n            \n            <tr><td style=\"padding: 8px; border: 1px solid #ddd; margin-top: 10px;\">Expected Dry Stock Cash</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ doc.get_formatted(\"expected_dry_stock_cash\") }}</td></tr>\n            <tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Actual Dry Stock Cash</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ doc.get_formatted(\"actual_dry_stock_cash\") }}</td></tr>\n            <tr style=\"font-weight: bold; background-color: #f9fafb;\"><td style=\"padding: 8px; border: 1px solid #ddd;\">Dry Stock Variance</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right; color: {% if doc.dry_stock_cash_variance < 0 %}#dc2626{% else %}#16a34a{% endif %};\"><span style=\"color: {% if doc.dry_stock_cash_variance < 0 %}red{% else %}green{% endif %}\">{{ doc.get_formatted(\"dry_stock_cash_variance\") }}</span></td></tr>\n        </tbody>\n    </table>\n\n    <h3 style=\"border-bottom: 1px solid #eee; padding-bottom: 5px;\">2. Sales Breakdown</h3>\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\n        <thead>\n            <tr style=\"background-color: #f3f4f6;\">\n                <th style=\"padding: 8px; border: 1px solid #ddd; text-align: left;\">Category</th>\n                <th style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Credit Invoices</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ \"{:,.2f}\".format(sum([row.amount for row in (doc.invoices or [])])) }}</td></tr>\n            <tr><td style=\"padding: 8px; border: 1px solid #ddd;\">M-Pesa Collections</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ \"{:,.2f}\".format(sum([row.amount for row in (doc.mpesa_payments or [])])) }}</td></tr>\n            <tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Card Payments</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ \"{:,.2f}\".format(sum([row.amount for row in (doc.card_payments or [])])) }}</td></tr>\n            <tr><td style=\"padding: 8px; border: 1px solid #ddd;\">Expenses</td><td style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">{{ \"{:,.2f}\".format(sum([row.amount for row in (doc.shift_expenses or [])])) }}</td></tr>\n        </tbody>\n    </table>\n    \n    <h3 style=\"border-bottom: 1px solid #eee; padding-bottom: 5px;\">3. CSA Variances</h3>\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 30px;\">\n        <thead>\n            <tr style=\"background-color: #f3f4f6;\">\n                <th style=\"padding: 8px; border: 1px solid #ddd; text-align: left;\">CSA</th>\n                <th style=\"padding: 8px; border: 1px solid #ddd; text-align: right;\">Variance</th>\n                <th style=\"padding: 8px; border: 1px solid #ddd; text-align: center;\">Signature</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% set recons = frappe.get_all(\"Shift Cash Reconciliation\", filters={\"shift\": doc.name}, fields=[\"csa\", \"variance\"]) %}\n            {% if recons %}\n                {% for r in recons %}\n                <tr>\n                    <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ frappe.db.get_value(\"Employee\", r.csa, \"employee_name\") or r.csa }}</td>\n                    <td style=\"padding: 8px; border: 1px solid #ddd; text-align: right; font-weight: bold; color: {% if r.variance < 0 %}#dc2626{% else %}#16a34a{% endif %};\"><span style=\"color: {% if r.variance < 0 %}red{% else %}green{% endif %}\">{{ \"{:,.2f}\".format(r.variance) }}</span></td>\n                    <td style=\"padding: 8px; border: 1px solid #ddd; text-align: center;\">________________________</td>\n                </tr>\n                {% endfor %}\n            {% else %}\n                <tr><td colspan=\"3\" style=\"padding: 8px; border: 1px solid #ddd; text-align: center;\">No CSA Reconciliations found</td></tr>\n            {% endif %}\n        </tbody>\n    </table>\n\n    <div style=\"margin-top: 50px; display: flex; justify-content: space-between;\">\n        <div style=\"width: 45%; border-top: 1px solid #333; padding-top: 10px; text-align: center;\">\n            <p style=\"margin: 0;\"><b>Manager Signature</b></p>\n            <p style=\"margin: 5px 0 0 0; font-size: 0.9em; color: #666;\">Date: ________________</p>\n        </div>\n        <div style=\"width: 45%; border-top: 1px solid #333; padding-top: 10px; text-align: center;\">\n            <p style=\"margin: 0;\"><b>Owner/Auditor Signature</b></p>\n            <p style=\"margin: 5px 0 0 0; font-size: 0.9em; color: #666;\">Date: ________________</p>\n        </div>\n    </div>\n</div>"
}
