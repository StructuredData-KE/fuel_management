             <input type="date" id="global-date-start" class="bg-white border border-slate-300 hover:border-slate-400 rounded-lg px-2 py-1.5 text-sm font-medium text-slate-700 focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 w-full sm:w-auto shadow-sm transition-all" />
             <span class="text-slate-400 font-medium">-</span>
             <input type="date" id="global-date-end" class="bg-white border border-slate-300 hover:border-slate-400 rounded-lg px-2 py-1.5 text-sm font-medium text-slate-700 focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 w-full sm:w-auto shadow-sm transition-all" />
          </div>
        </div>

        <div id="tab-dashboard" class="tab-content w-full">
            
<!-- Desktop Header Row (Context & Global Actions) -->
<div class="d-none d-md-flex justify-between items-end mb-6">
<div>
<h1 class="text-[32px] leading-tight font-bold text-slate-900 tracking-tight">System Overview</h1>
<p class="text-[13px] font-mono text-slate-500 mt-1">Real-time telemetry &amp; financial metrics.</p>
</div>
<div class="flex gap-2">
<button class="bg-white hover:bg-slate-50 text-slate-700 px-4 py-2 rounded-lg text-sm font-semibold transition-colors flex items-center gap-2 border border-slate-200 shadow-sm">
<span class="material-symbols-outlined text-[18px]">download</span>
                    Export Shift Report
                </button>
</div>
</div>
<!-- KPI Row: Bento Box High Density -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-card-gap">
<!-- Total Sales -->
<div class="bg-surface-container-lowest p-4 rounded-lg border border-surface-border flex flex-col hover:bg-surface-container-low transition-colors group shadow-sm">
<div class="flex justify-between items-start mb-2">
<span class="font-label-caps text-label-caps text-text-secondary uppercase">Total Sales (Today)</span>
<span class="material-symbols-outlined text-secondary text-[18px]">trending_up</span>
</div>
<div class="font-data-lg text-data-lg text-text-primary mt-1 group-hover:text-accent-amber transition-colors">
                    $142,500.00
                </div>
<div class="mt-2 h-1 w-full bg-surface-border rounded-full overflow-hidden">
<div class="h-full bg-secondary w-[85%] rounded-full"></div>
</div>
<span class="font-data-sm text-data-sm text-text-secondary mt-2 text-right">85% of daily target</span>
</div>
<!-- Collections -->
<div class="bg-surface-container-lowest p-4 rounded-lg border border-surface-border flex flex-col hover:bg-surface-container-low transition-colors group shadow-sm">
<div class="flex justify-between items-start mb-2">
<span class="font-label-caps text-label-caps text-text-secondary uppercase">Collections Split</span>
<span class="material-symbols-outlined text-tertiary text-[18px]">account_balance</span>
</div>
<div class="font-data-lg text-data-lg text-text-primary mt-1">
                    $138,200.00
                </div>
<div class="flex gap-1 mt-3">
<!-- Sparkline/Bar substitute -->
<div class="h-2 bg-accent-amber rounded-l-full w-[40%]" title="M-Pesa: 40%"></div>
<div class="h-2 bg-tertiary w-[35%]" title="Cards: 35%"></div>
<div class="h-2 bg-secondary rounded-r-full w-[25%]" title="Cash: 25%"></div>
</div>
<div class="flex justify-between font-data-sm text-data-sm mt-2 text-text-secondary">
<span class="flex items-center gap-1"><div class="w-2 h-2 rounded-full bg-accent-amber"></div>M-Pesa</span>
<span class="flex items-center gap-1"><div class="w-2 h-2 rounded-full bg-tertiary"></div>Cards</span>
<span class="flex items-center gap-1"><div class="w-2 h-2 rounded-full bg-secondary"></div>Cash</span>
</div>
</div>
<!-- Net Variance -->
<div class="bg-surface-container-lowest p-4 rounded-lg border border-surface-border flex flex-col hover:bg-surface-container-low transition-colors group shadow-sm">
<div class="flex justify-between items-start mb-2">
