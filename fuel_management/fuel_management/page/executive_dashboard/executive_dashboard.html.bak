
<style>
      /* Prevent Frappe CSS conflicts */
      .dashboard-wrapper * {
          box-sizing: border-box;
      }
      .dashboard-wrapper {
          font-family: "Inter", sans-serif;
      }
      /* Hide scrollbars for cleaner look */
      ::-webkit-scrollbar {
          width: 6px;
          height: 6px;
      }
      ::-webkit-scrollbar-track {
          background: transparent;
      }
      ::-webkit-scrollbar-thumb {
          background: #cbd5e1;
          border-radius: 3px;
      }
      ::-webkit-scrollbar-thumb:hover {
          background: #94a3b8;
      }
      /* Fix for Frappe page container padding */
      .page-body {
          padding: 0 !important;
      }
      .page-content {
          padding: 0 !important;
          margin: 0 !important;
      }
  </style>

  <div class="dashboard-wrapper min-h-screen flex flex-col md:flex-row bg-background text-text-primary" style="margin: -15px; width: calc(100% + 30px);">
    
<!-- TopNavBar (Mobile Only) / Header -->
