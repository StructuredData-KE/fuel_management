        <div class="bg-white border-b border-slate-200 pb-4 flex flex-col sm:flex-row gap-4 justify-between items-center z-30 mb-2">
          <div class="flex items-center gap-2 w-full sm:w-auto">
             <select id="global-station-filter" class="bg-white border border-slate-300 hover:border-slate-400 rounded-lg px-3 py-1.5 text-sm font-medium text-slate-700 focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 w-full sm:w-auto cursor-pointer shadow-sm transition-all">
