                    -$4,300.00
                </div>
<div class="mt-auto pt-3 border-t border-surface-border">
<span class="font-data-sm text-data-sm text-error bg-error-container px-2 py-1 rounded text-[10px] uppercase font-bold tracking-wider inline-flex items-center gap-1">
<span class="material-symbols-outlined text-[12px]">arrow_downward</span> 3.01%
                    </span>
<span class="font-data-sm text-data-sm text-text-secondary ml-2">vs. projected</span>
</div>
</div>
</div>
<!-- Main Chart & Alerts Row -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-card-gap flex-1">
