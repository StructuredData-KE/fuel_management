<div class="w-3 md:w-6 bg-surface-border border border-outline-variant h-[55%] rounded-t-sm"></div>
<div class="w-3 md:w-6 bg-accent-amber h-[90%] rounded-t-sm group-hover:bg-primary transition-colors"></div>
</div>
<span class="font-data-sm text-data-sm text-text-secondary mt-2">W4</span>
</div>
</div>
