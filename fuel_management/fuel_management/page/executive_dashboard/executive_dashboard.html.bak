                    System Alerts
                    <span class="bg-error-container text-on-error-container font-data-sm text-data-sm px-2 py-0.5 rounded-full">3 Active</span>
</h2>
<div class="flex flex-col gap-dense-gap overflow-y-auto pr-1">
<!-- Alert Item 1 -->
<div class="bg-surface-container-low p-3 rounded flex items-start gap-3 border-l-2 border-error">
